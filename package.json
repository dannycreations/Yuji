    "clsx": "^2.1.1",
    "effect": "^3.22.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.27.0",
    "mermaid": "^11.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
