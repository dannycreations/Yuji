{
  "name": "yuji-workspace",
  "version": "0.0.0",
  "author": "dannycreations",
  "license": "GPL",
  "type": "module",
  "private": true,
  "scripts": {
    "start:server": "pnpm --filter @yuji/server start",
    "dev": "pnpm --filter @yuji/client dev",
    "dev:server": "pnpm --filter @yuji/server dev",
    "build": "pnpm --filter @yuji/client build",
    "check": "pnpm run format && pnpm -r check",
    "format": "prettier --write .",
    "update": "npm-check-updates -u --workspaces",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dannycreations/Yuji.git"
  },
  "homepage": "https://github.com/dannycreations/Yuji",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.6"
  },
  "packageManager": "pnpm@11.24.0"
}
